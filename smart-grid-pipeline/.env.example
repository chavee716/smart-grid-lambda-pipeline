# Copy to .env and adjust as needed. docker-compose.yml already sets sane
# defaults for the in-cluster hostnames; this file is for local (non-docker)
# runs of individual scripts, e.g. `python simulators/smart_meter_streamer.py`.

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=smartgrid
POSTGRES_USER=grid_user
POSTGRES_PASSWORD=grid_pass

DATA_LAKE_ROOT=./data/lake
BATCH_DROPZONE_PATH=./data/batch_dropzone

SIMULATED_DAY_SECONDS=300
METER_EMIT_INTERVAL_SECONDS=2
NUM_HOUSEHOLDS=40

LOW_RENEWABLE_SHARE_THRESHOLD=0.15
NO_DATA_ALERT_MINUTES=2
ERROR_RATE_ALERT_THRESHOLD=0.05
